<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许局域网明文 HTTP（用于连接 DSH 桥接服务），生产环境建议改为 https -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
